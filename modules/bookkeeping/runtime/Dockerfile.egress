# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim
ENV NODE_ENV=production PORT=3128
WORKDIR /proxy
RUN groupadd --system --gid 10002 bergbok-proxy \
    && useradd --system --uid 10002 --gid bergbok-proxy --home-dir /proxy --shell /usr/sbin/nologin bergbok-proxy
COPY --chown=10002:10002 modules/bookkeeping/runtime/egress-proxy.mjs ./server.mjs
USER 10002:10002
EXPOSE 3128
CMD ["node", "server.mjs"]
