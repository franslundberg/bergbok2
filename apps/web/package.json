{
  "name": "@bergbok/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3006",
    "worker": "node --env-file=.env.local --experimental-strip-types worker/bookkeeping-worker.ts",
    "workspace-manager": "node --env-file=.env.local manager/server.mjs",
    "setup:manager": "npm --prefix manager ci",
    "setup:chat-image": "docker build -t bergbok-chat-worker:local -f Dockerfile.chat-worker .",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:docker": "RUN_DOCKER_TESTS=1 node --experimental-strip-types --test test/docker.test.ts",
    "test:live": "RUN_LIVE_AI=1 node --env-file-if-exists=../../.env.local --env-file-if-exists=.env.local --experimental-strip-types --test test/live.test.ts",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "format": "oxfmt --check",
    "format:fix": "oxfmt"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.40",
    "@assistant-ui/react": "latest",
    "@assistant-ui/react-ai-sdk": "latest",
    "@assistant-ui/react-markdown": "latest",
    "@assistant-ui/react-ui": "^0.2.1",
    "@base-ui/react": "^1.7.0",
    "@bergbok/modular-system": "file:../..",
    "ai": "^7.0.62",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "nodemailer": "^9.0.5",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.12",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@assistant-ui/next": "latest",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
