BERGBOK_OWNER_EMAIL=owner@example.se
AUTH_PEPPER=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
BERGBOK_SECURE_COOKIES=false
SMTP_HOST=smtp.example.se
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=Bergbok <bergbok@example.se>
SMTP_USER=
SMTP_PASS=
BERGBOK_DATA_ROOT=/Users/you/path/to/bergbok2/var
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium
WORKSPACE_MANAGER_URL=http://127.0.0.1:8086
WORKSPACE_MANAGER_TOKEN=replace-with-at-least-24-random-characters
BERGBOK_SNAPSHOT_ROOT=/Users/you/path/to/bergbok2/var/chat-snapshots
DOCKER_SOCKET=/Users/you/.docker/run/docker.sock
